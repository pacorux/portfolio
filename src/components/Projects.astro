---
import { SendIcon, SquareArrowOutUpRightIcon } from "@lucide/astro";

const projects = [
  {
    title: "Transfer",
    description: [
      "Aplicación web para enviar archivos en tiempo real.",
      "A través de tu red local o directamente por internet.",
      "¡Directo, rápido y seguro!",
    ],
    tags: ["WebRTC"],
    repository: "https://github.com/pacorux/transfer",
    link: "https://transfer.pacorux.es/",
    Icon: SendIcon,
  },
];
---

<section
  id="projects"
  class="min-h-dvh bg-linear-to-b from-background to-background-secondary p-8"
>
  <div class="w-full max-w-6xl mx-auto flex flex-col items-center gap-2">
    <!-- Title -->
    <h2 class="font-gluten text-3xl font-semibold text-accent mb-14">
      Proyectos
    </h2>

    <!-- Grid -->
    <div
      class="w-full max-w-6xl mx-auto grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] justify-center justify-items-center gap-5 p-4"
    >
      {
        projects.map(
          ({ title, description, Icon, tags, link, repository }, index) => (
            <article class="flex gap-4 bg-background-secondary p-4 rounded-(--radius) w-full max-w-lg shadow">
              {/* Project - Aside */}
              <div class="relative flex items-center justify-center w-32">
                <span class="absolute -top-5 -left-6 rotate-6 font-gluten font-extrabold text-4xl text-danger opacity-80 select-none">
                  #{index + 1}
                </span>

                <a
                  href={link}
                  draggable="false"
                  target="_blank"
                  referrerpolicy="strict-origin-when-cross-origin"
                  rel="noopener noreferrer"
                >
                  <Icon size={52} class="text-accent" />
                </a>
              </div>

              {/* Project - Content */}
              <div>
                <header>
                  <h3 class="font-gluten text-xl font-semibold mb-2">
                    {title}
                  </h3>
                </header>
                <body class="">
                  {description.map((line) => (
                    <p class="text-sm leading-relaxed">{line}</p>
                  ))}

                  <div class="mt-4 flex items-center gap-3">
                    {link && (
                      <a
                        href={link}
                        class="text-foreground hover:text-accent hover:scale-110 active:scale-95"
                        draggable="false"
                        target="_blank"
                        referrerpolicy="strict-origin-when-cross-origin"
                        rel="noopener noreferrer"
                      >
                        <SquareArrowOutUpRightIcon size={16} />
                      </a>
                    )}

                    {repository && (
                      <>
                        <a
                          href={repository}
                          class="text-foreground hover:text-accent hover:scale-110 active:scale-95"
                          draggable="false"
                          target="_blank"
                          referrerpolicy="strict-origin-when-cross-origin"
                          rel="noopener noreferrer"
                        >
                          <svg
                            role="img"
                            viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg"
                            fill="currentColor"
                            class="h-4 w-4"
                          >
                            <title>GitHub</title>
                            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                          </svg>
                        </a>
                      </>
                    )}
                  </div>
                </body>

                <footer>
                  <div class="flex gap-1 mt-6">
                    {tags.map((tag) => (
                      <span class="chip font-semibold select-none">{tag}</span>
                    ))}
                  </div>
                </footer>
              </div>
            </article>
          ),
        )
      }
    </div>
  </div>
</section>
