---
import "../styles/global.css";
import "../components/Background.astro";
import Background from "../components/Background.astro";
import ScrollUpButton from "../components/ScrollUpButton.astro";

const {
  title = "Pacorux | Desarrollador Web",
  author = "Pacorux",
  description = "Portafolio personal para mostrar proyectos en desarrollo web",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark light" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <title>{title}</title>

    <!-- About -->
    <meta name="author" content={author} />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://pacorux.es" />
    <meta property="og:image" content="https://pacorux.es/og-image.jpg" />
  </head>
  <body>
    <slot />

    <ScrollUpButton />
    <Background />
  </body>
</html>
